BAI_API_KEY=
BAI_MODEL=gpt-5.4-mini
# Reasoning effort for the main assistant (minimal/low/medium/high); blank disables the parameter.
MAIN_REASONING_EFFORT=low
BAI_BASE_URL=https://api.b.ai/v1
AGENT_TOOL_TRANSPORT=function
REDIS_URL=redis://127.0.0.1:6379/1
CACHE_PREFIX=hkpet
CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=60
# Above CHAT_RATE_LIMIT requests per window are served by FALLBACK_MODEL; above the hard limit they get 429.
CHAT_RATE_HARD_LIMIT=60
# Max simultaneous full-model chats per process; overflow waits LLM_QUEUE_TIMEOUT_SECONDS, then degrades.
LLM_MAX_CONCURRENCY=8
LLM_FALLBACK_CONCURRENCY=32
LLM_QUEUE_TIMEOUT_SECONDS=5
FALLBACK_MODEL=gpt-5.4-nano

# Tool-free intent gate, using BAI_API_KEY / BAI_BASE_URL; no silent fallback.
INTENT_MODEL=gpt-5.4-nano
INTENT_CONFIDENCE_THRESHOLD=0.75
INTENT_TIMEOUT_SECONDS=20

# Restricted web research sub-agent; blank key/base URL reuse BAI credentials.
WEB_SEARCH_MODEL=gpt-5.4-mini
WEB_SEARCH_TIMEOUT_SECONDS=60
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=

# Shared snapshot location (leave blank to use data/pet-snapshot.json).
PET_SNAPSHOT_PATH=
# Web processes only check for a newly published snapshot; never fetch upstream.
SNAPSHOT_POLL_SECONDS=30
# Dedicated sync worker checks every 10 min; refresh public data after 6 hours.
SYNC_CHECK_SECONDS=600
SNAPSHOT_MAX_AGE_SECONDS=21600

# Persistent conversations: Render Postgres Internal Database URL (same region).
DATABASE_URL=
# Private trace lookup API bearer token; leave empty to disable trace retrieval.
TRACE_ADMIN_TOKEN=
