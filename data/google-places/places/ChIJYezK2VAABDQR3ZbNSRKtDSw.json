        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pGSGRsSmFaRlJPWW5wRGVYQk9SVVZKUWtSUGMyYxAB!2m1!1s0x34040050d9caec61:0x2c0dad1249cd96dd"
