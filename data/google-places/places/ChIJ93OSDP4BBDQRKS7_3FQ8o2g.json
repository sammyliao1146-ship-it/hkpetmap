        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25JeVEydG5URmN6VDBodGFUbFJlRGxOU0c5T1NXYxAB!2m1!1s0x340401fe0c9273f7:0x68a33c54dcff2e29"
