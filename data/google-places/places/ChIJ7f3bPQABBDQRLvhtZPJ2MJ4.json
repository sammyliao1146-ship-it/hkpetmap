        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25jM1dUQlVhbVYzVHpaMU5GOWtXWGhaZUZGQ0xVRRAB!2m1!1s0x340401003ddbfded:0x9e3076f2646df82e"
