        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2prMlpVZzRTVVo0T1VSVk0yaFJOa2s0Tm1scFZrRRAB!2m1!1s0x340401b99ee1d99d:0xf28f821df94e886f"
