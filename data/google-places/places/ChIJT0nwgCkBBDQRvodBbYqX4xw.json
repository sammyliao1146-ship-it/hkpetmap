        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21sWVFXUnRkMlF5WVVaaWFVTnVSMDlVV2pkWWRVRRAB!2m1!1s0x3404012980f0494f:0x1ce3978a6d4187be"
