        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xsTFRqaHFURTlrZUVOMlIxbFFhbmgxZDNCWlEwRRAB!2m1!1s0x340403c8d857d5ef:0xff2306a7b6c70c82"
