        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21sVGRUWXRaMjFpYVRGVk9YWjRhekV3ZGpKR2IxRRAB!2m1!1s0x340401f55f1ca247:0xb23409ea1a5d0821"
