        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xCcWNESldSbFE0TkZBMlJrNUJWMlZHUVRNMlQzYxAB!2m1!1s0x340401c369dc6c21:0x5b9369d3202e0e84"
