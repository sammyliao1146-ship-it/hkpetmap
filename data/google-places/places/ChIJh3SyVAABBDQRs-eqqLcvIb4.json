          "photoUri": "https://lh3.googleusercontent.com/a/ACg8ocLz4ACnZrNNKZZFUQ-N15afRXFMBO9hBw8bLxb2x798s7LlaA=s128-c0x00000000-cc-rp-mo-ba5"
        },
        "publishTime": "2024-07-30T15:21:04.025885Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChdDSUhNMG9nS0VJQ0FnSUNicF9MVmd3RRAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSUNicF9MVmd3RRAB!2m1!1s0x3404010054b27487:0xbe212fb7a8aae7b3"
