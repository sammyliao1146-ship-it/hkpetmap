        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2paUlpsRlRhVE55VVVSS01sZzFVek0xVURCTlZWRRAB!2m1!1s0x340400edfe1f23ff:0x1d0ce3f778c1a71c"
