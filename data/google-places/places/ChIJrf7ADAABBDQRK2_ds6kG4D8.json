        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21oV00xUndObko1VjA1aU4xaGZNSGxxWDFnek5FRRAB!2m1!1s0x340401000cc0fead:0x3fe006a9b3dd6f2b"
