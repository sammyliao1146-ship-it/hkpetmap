        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJcnVyY2pNaEo3SEF3EAE!2m1!1s0x340400eed5b31b11:0x32d94f40e17fbcdd"
