        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT20xT2VXTnVZMkZ1VWxjemVHZ3pjV1oyYjJOeWMxRRAB!2m1!1s0x3403f9218752cc69:0x28f6157dabea46db"
