        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21kcVYxWmlWMVpHTWtGdmNrMUZPRXczUm1wVFEwRRAB!2m1!1s0x340407091460fe93:0xd679d8f172a9595c"
