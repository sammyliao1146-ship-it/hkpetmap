        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25CUlRUVnFjWGRpU21aaU9URmhSMFo0YmpoWU9IYxAB!2m1!1s0x3404072d602de339:0x572de97f529533a5"
