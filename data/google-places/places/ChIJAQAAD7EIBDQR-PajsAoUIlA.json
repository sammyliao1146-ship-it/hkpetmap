        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21KSmFETnVVVk5aWW5wTGJEVlJka3BVVDFveFVtYxAB!2m1!1s0x340408b10f000001:0x5022140ab0a3f6f8"
