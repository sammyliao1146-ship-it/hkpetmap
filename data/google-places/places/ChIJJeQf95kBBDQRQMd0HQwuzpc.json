        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2pnM2VsSk5UVmwxWW14RGQyUkhXSGR0WTJKMFgwRRAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pnM2VsSk5UVmwxWW14RGQyUkhXSGR0WTJKMFgwRRAB!2m1!1s0x34040199f71fe425:0x97ce2e0c1d74c740"
