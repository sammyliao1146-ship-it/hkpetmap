        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tVM1Nsb3lYMlU1TFRKUE0zWkVUbTk2UW5ZMk1GRRAB!2m1!1s0x34040199f71fe425:0x97ce2e0c1d74c740"
