        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSUNfN0k2Tnh3RRAB!2m1!1s0x3404010c5a2fe80f:0xd8054e897aa352ab"
