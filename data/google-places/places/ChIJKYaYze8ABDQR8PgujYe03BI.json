        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tGclYyaEJUekZLUXpSbVFYazBVblZaVUZWQ1FXYxAB!2m1!1s0x340400efcd988629:0x12dcb4878d2ef8f0"
