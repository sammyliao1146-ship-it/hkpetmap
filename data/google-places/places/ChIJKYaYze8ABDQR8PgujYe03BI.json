        },
        "publishTime": "2025-07-21T01:59:26.914855944Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT25sQ015MWpZMkpmWjNCM1dWSllPV1prTkRSMmRFRRAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25sQ015MWpZMkpmWjNCM1dWSllPV1prTkRSMmRFRRAB!2m1!1s0x340400efcd988629:0x12dcb4878d2ef8f0"
