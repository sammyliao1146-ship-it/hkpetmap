        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pGMVp6TjBjRmhLTnpWamMxVlRWRWs1Y1VsNFgyYxAB!2m1!1s0x3403e300344929b3:0x2255f534f18af302"
