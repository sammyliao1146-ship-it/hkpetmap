        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2s1R1pGSmphakZSV0dzeU5HaEhYMEU0TlRodlUzYxAB!2m1!1s0x3404070029129f97:0x68b4239e61ef6bc5"
