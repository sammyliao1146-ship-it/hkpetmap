        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2s5Q2VtYzJVVTVITFVGSVFrcGxjMU0zU1hKbWNHYxAB!2m1!1s0x34040056600c3ab3:0xa446839bbc7cbd7e"
