        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VKM1ZuX1NwLTg3emN3EAE!2m1!1s0x3403f8eeb17ef4ed:0x381d3a7791292cb2"
