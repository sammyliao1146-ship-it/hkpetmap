        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChdDSUhNMG9nS0VJQ0FnSURqcEwyMndBRRAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSURqcEwyMndBRRAB!2m1!1s0x3403f8eeb17ef4ed:0x381d3a7791292cb2"
