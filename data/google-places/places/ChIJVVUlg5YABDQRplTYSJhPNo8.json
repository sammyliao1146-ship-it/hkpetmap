        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2w5VlptTnJMWFJ0Wm5kNFQxVnhRMmREVFdGMmJXYxAB!2m1!1s0x3404009683255555:0x8f364f9848d854a6"
