        "authorAttribution": {
          "displayName": "Tiffany Fung",
          "uri": "https://www.google.com/maps/contrib/113643612567390523238/reviews",
          "photoUri": "https://lh3.googleusercontent.com/a-/ALV-UjUFn9DXCXzXmxBelu9qD1cllyZQ3hnJHyRRBmvacKngPkLbHl96=s128-c0x00000000-cc-rp-mo-ba6"
        },
        "publishTime": "2026-04-24T12:39:22.413199833Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT25wNVVUSjBSM0ZyU0hjMk1XRlFZWEpDTmpsNVYwRRAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25wNVVUSjBSM0ZyU0hjMk1XRlFZWEpDTmpsNVYwRRAB!2m1!1s0x340401ceab220659:0xa5e84dc2426e631a"
