        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21GNFVHRlZSSEIxVEZadFJXaERiMnBGVFZsSVVYYxAB!2m1!1s0x340401fc881d2fe1:0xdda94530870d6b6b"
