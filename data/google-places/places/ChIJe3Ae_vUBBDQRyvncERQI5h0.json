        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSUNEM1BES2tBRRAB!2m1!1s0x340401f5fe1e707b:0x1de6081411dcf9ca"
