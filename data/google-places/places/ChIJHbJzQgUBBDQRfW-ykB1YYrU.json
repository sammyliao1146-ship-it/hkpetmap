        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSURDdGVQYzJnRRAB!2m1!1s0x340401054273b21d:0xb562581d90b26f7d"
