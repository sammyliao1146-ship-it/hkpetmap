        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xOeFkzQndNV1JFYnpsR01teHVSVVptTkZsME5rRRAB!2m1!1s0x340407280bb1828b:0x82acd72bf33a48ce"
