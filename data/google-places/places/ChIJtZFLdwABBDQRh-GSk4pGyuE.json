        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xnMFRuSkhXVGwzTVRGZmMySlNXVEo2VFRKSU9XYxAB!2m1!1s0x34040100774b91b5:0xe1ca468a9392e187"
