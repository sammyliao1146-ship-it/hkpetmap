        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25oT2NWbHBUbnBrYkVOMU5EUnFWRVEzTURWSlpYYxAB!2m1!1s0x3403ff00128b5b25:0x23d911a0a1c11e19"
