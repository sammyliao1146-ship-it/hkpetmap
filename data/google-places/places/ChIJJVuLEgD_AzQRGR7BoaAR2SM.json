        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT21KbFVIbDRhVUZIVUV4bVdGUmhRV1pQTmpGUU4wRRAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21KbFVIbDRhVUZIVUV4bVdGUmhRV1pQTmpGUU4wRRAB!2m1!1s0x3403ff00128b5b25:0x23d911a0a1c11e19"
