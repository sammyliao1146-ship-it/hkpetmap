        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tOVllrVmZSbFZ5TmxSQ1pIQklablZrZDJscmJHYxAB!2m1!1s0x34040120ab0874a1:0x5eea481b41cc69bf"
