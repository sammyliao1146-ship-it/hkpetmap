        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pOU1VVSTVVbkl5Ykc5R2ExQTVVVEJEU2tkZlYyYxAB!2m1!1s0x3403fb007f4e6385:0x564779dd8621a32f"
