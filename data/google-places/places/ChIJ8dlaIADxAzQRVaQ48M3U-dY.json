        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21OcFV6RmhPSFJJVERreVdqaGFZbGgyWTFOM1psRRAB!2m1!1s0x3403f100205ad9f1:0xd6f9d4cdf038a455"
