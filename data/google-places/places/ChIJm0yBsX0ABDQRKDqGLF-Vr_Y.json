        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2xKWmFFNWxWaTB0VDNoZmRFSm9iVmsyZEVSbVJFRRAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xKWmFFNWxWaTB0VDNoZmRFSm9iVmsyZEVSbVJFRRAB!2m1!1s0x3404007db1814c9b:0xf6af955f2c863a28"
