        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2paR1ZXaElXV3hqZGtKTGJEaDBOVlZyYzE5TVFsRRAB!2m1!1s0x3404007db1814c9b:0xf6af955f2c863a28"
