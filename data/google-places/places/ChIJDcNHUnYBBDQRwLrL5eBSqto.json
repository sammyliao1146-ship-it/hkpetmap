        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUM1cnBYQUVREAE!2m1!1s0x340401765247c30d:0xdaaa52e0e5cbbac0"
