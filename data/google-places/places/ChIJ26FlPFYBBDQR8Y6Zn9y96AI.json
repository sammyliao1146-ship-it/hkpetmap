        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tGTWVqazNUM0YyU2tob01ubHJkRTF6VkV4MFoyYxAB!2m1!1s0x340401563c65a1db:0x2e8bddc9f998ef1"
