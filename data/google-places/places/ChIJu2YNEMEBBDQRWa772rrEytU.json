        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xoVmNqbGhYMVkwYUhkeVRVZE5NV3gxWWxwdFMyYxAB!2m1!1s0x340401c1100d66bb:0xd5cac4badafbae59"
