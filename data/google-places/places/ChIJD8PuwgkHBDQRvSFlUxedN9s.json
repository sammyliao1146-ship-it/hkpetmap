        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2s5VWQwdDZXamgwTWxSTFVqSkNTSFJvVEU1alZWRRAB!2m1!1s0x34040709c2eec30f:0xdb379d17536521bd"
