        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJLTA4WUNwbkx6WWFnEAE!2m1!1s0x34040138ee6b439f:0x98b3fb566a7e097c"
