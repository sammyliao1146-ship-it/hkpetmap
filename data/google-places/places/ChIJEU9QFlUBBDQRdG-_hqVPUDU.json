        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21rNGVVY3pRVEJEVUV4blkyUjVaR1V4ZVUwMGRXYxAB!2m1!1s0x3404015516504f11:0x35504fa586bf6f74"
