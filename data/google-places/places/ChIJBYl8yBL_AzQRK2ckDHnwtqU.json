        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnTURJbC03SUdnEAE!2m1!1s0x3403ff12c87c8905:0xa5b6f0790c24672b"
