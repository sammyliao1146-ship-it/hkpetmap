        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2s4MFVISjVhbXQ1ZFhCaFpVNUVXVTlaWmkxUU9IYxAB!2m1!1s0x340407a76285a731:0xbcb0f1da0c3ef45d"
