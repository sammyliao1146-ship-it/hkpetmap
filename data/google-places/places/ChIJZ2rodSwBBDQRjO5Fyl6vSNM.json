        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tNNFYzaFBOM3BSTVdaVFNrdzFhRkoyUm1Vd2FIYxAB!2m1!1s0x3404012c75e86a67:0xd348af5eca45ee8c"
