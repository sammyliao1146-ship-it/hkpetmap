        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xOa1dFVnVlR3hwZDNVMGFHZ3hVSFV5YURsMmFIYxAB!2m1!1s0x3404014beb81e6dd:0x2691e8f2171d1b94"
