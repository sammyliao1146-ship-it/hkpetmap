        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUNfdnNPWFdnEAE!2m1!1s0x340401ade95a0e9f:0x2b9d912bae66bf9"
