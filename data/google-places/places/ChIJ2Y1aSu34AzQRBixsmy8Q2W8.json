        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VNdUc0Sm14OHNUZ1RBEAE!2m1!1s0x3403f8ed4a5a8dd9:0x6fd9102f9b6c2c06"
