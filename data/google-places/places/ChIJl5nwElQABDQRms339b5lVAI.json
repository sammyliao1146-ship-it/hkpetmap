        "publishTime": "2025-05-06T12:35:33.274099Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChZDSUhNMG9nS0VKejBuYW1ENE9LNVNBEAE&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VKejBuYW1ENE9LNVNBEAE!2m1!1s0x3404005412f09997:0x25465bef5f7cd9a"
