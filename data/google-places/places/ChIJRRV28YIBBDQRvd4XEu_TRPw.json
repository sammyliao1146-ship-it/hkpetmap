        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pGQmRWZHNha2R2Y1V4SWNrNWhUemM0VGpselJVRRAB!2m1!1s0x34040182f1761545:0xfc44d3ef1217debd"
