        "publishTime": "2026-06-14T09:11:18.951773955Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2xaV2JHdzJVV1ZVYW5RMExUUlRNRXN4WmxwMmJFRRAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xaV2JHdzJVV1ZVYW5RMExUUlRNRXN4WmxwMmJFRRAB!2m1!1s0x3403ff425b7549e5:0xb0f08e1c3714a83b"
