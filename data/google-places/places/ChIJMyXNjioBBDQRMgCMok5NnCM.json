        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pGU1ZWTnNkSEIzUVZwelR5MW5ia05SVTJSVlZGRRAB!2m1!1s0x3404012a8ecd2533:0x239c4d4ea28c0032"
