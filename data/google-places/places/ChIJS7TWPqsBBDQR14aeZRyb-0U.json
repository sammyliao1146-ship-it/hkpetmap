        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSURicmNLbG53RRAB!2m1!1s0x340401ab3ed6b44b:0x45fb9b1c659e86d7"
