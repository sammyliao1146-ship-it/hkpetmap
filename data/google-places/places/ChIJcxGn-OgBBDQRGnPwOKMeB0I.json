        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25SemQwUmlkV1oyTTFsTk9IQXhia1UxYmxocUxXYxAB!2m1!1s0x340401e8f8a71173:0x42071ea338f0731a"
