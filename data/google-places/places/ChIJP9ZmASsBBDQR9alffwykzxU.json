        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnTUNnNGRyUWp3RRAB!2m1!1s0x3404012b0166d63f:0x15cfa40c7f5fa9f5"
