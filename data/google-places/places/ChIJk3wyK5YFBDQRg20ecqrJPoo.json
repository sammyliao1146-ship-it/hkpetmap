        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnTUNBOTVuTkZBEAE!2m1!1s0x340405962b327c93:0x8a3ec9aa721e6d83"
