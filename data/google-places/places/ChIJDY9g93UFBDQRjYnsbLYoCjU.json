        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnTURJb3Y2SG5BRRAB!2m1!1s0x34040575f7608f0d:0x350a28b66cec898d"
