        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21GRE5sZFdTalUwZFRVdFIxOVBOemRwTkROcWVHYxAB!2m1!1s0x3403f1ec37e299ad:0x50f36d3d3abab4be"
