        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2psRU9EUkJlV1JUUVVaSFZFcFlRVk52ZVVaNmFGRRAB!2m1!1s0x3404013ef97c6d8f:0xeb4404da230cb39e"
