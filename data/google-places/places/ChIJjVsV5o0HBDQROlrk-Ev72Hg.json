        "authorAttribution": {
          "displayName": "Tang Henry",
          "uri": "https://www.google.com/maps/contrib/106936313886268971386/reviews",
          "photoUri": "https://lh3.googleusercontent.com/a-/ALV-UjViJD3F2Q0EglVRHROhwD7UmmnejkAwYh_8-pGYvPKC29MLMtHS0w=s128-c0x00000000-cc-rp-mo-ba6"
