        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2twSmEzQmphazlJY0d4Q1RGaGZORVoyUVhBM2IwRRAB!2m1!1s0x3404078de6155b8d:0x78d8fb4bf8e45a3a"
