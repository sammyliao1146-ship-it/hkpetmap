        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT205d1RITk1hbTQ1Ym5ac1JpMWpRM2xzYTJ4c1NWRRAB!2m1!1s0x34040148e328c3e5:0xe5ecd1f222b0f3db"
