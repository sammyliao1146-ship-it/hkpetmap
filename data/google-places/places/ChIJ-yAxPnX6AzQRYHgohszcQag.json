        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUQ5bXNMTUtREAE!2m1!1s0x3403fa753e3120fb:0xa841dccc86287860"
