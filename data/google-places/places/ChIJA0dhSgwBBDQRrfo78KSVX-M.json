        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2t4d1ZrSmlZVTlaZDNVMFVESnRWeTFVYjNoU1JIYxAB!2m1!1s0x3404010c4a614703:0xe35f95a4f03bfaad"
