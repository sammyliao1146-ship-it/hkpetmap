        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tsQk0zZEpZa1I2WjB4UU1HdzJia1pyUVdoclVVRRAB!2m1!1s0x340401bb3b42cab7:0xd3eee094cb3d970e"
