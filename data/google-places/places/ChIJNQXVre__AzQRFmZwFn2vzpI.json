        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUR1LXVQZE1BEAE!2m1!1s0x3403ffefadd50535:0x92ceaf7d16706616"
