        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xSTmRVbGZWbVZrWTB0d2FXUjVTR0p6TlUxcVVsRRAB!2m1!1s0x3403f611ce941f0f:0x34f946779389e388"
