        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tKNVIzTnlTM0pmVG0xak5HOXdiSEZXWlVGMGRYYxAB!2m1!1s0x3403f91e9ba8873b:0x4ba15aa14364759d"
