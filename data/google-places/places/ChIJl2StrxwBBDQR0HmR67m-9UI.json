        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUNjazlMa0dBEAE!2m1!1s0x3404011cafad6497:0x42f5beb9eb9179d0"
