        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xGcU5uYzBYMjkxWVRKTGEwZGFPV1IyUWtSWmNtYxAB!2m1!1s0x3404073146e04a73:0x2a5023efb2c222f3"
