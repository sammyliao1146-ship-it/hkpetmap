        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21Ga09GVlBVbXhMVHpGbWJFdEpiM04zU0RVNFFuYxAB!2m1!1s0x3404019aea890287:0x14b19cfe4343ed34"
