        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT210Nk0yaDJiRTVhUzNsM2QzSmllWGRpYkRaTk5VRRAB!2m1!1s0x340407d902f2ee63:0x6b6f1287edc7d401"
