        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25WTExTMUtVWEpvVkhCU2JESm9VbTVNVVdsMVdGRRAB!2m1!1s0x340407d902f2ee63:0x6b6f1287edc7d401"
