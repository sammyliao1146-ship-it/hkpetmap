        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pCV1prdFZSRFZtUVU1VllrbzBTbEUxVnpSV1ZFRRAB!2m1!1s0x340407c4db1ac7c1:0xf12793bff373a78a"
