        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pCNVRISkNaVVZQWXpSSE1USk5SamRGWkVwWmIwRRAB!2m1!1s0x340401eeaa1a2033:0xb256bcf75bda6a44"
