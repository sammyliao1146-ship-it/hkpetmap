        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21kTlIxTk1WMHBsTFdsMWFGSnJhSFJMWmpBeVZIYxAB!2m1!1s0x340401b8988aa87d:0x1ce2baf7bdc5f668"
