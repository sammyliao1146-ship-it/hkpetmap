        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tWWGNubHNkR2cxVkdFd2JXWlBhbVEyZFRONE1GRRAB!2m1!1s0x3404015342e637e3:0x8ba39d71d0b3a13d"
