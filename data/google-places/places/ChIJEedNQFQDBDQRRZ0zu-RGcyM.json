        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2twdlpsQk9ZamRUTVhSaWIxZFJOa05FVlVaS1NYYxAB!2m1!1s0x34040354404de711:0x237346e4bb339d45"
