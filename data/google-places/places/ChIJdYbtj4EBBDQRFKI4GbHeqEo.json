        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25wVE5UZFZlR2hKUzJoMVJrcHNWbVZ5T0VSeE9IYxAB!2m1!1s0x340401818fed8675:0x4aa8deb11938a214"
