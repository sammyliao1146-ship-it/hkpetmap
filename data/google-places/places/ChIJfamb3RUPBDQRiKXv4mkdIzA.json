        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2psS1YzRnlkalZRUmtGQloxaENTa040TWt4alVsRRAB!2m1!1s0x34040f15dd9ba97d:0x30231d69e2efa588"
