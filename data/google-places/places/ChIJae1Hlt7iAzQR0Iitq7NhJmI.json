        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tkUldXSnlaa2hTWW1ab1h5MU9SWFJMUjJ0T1ptYxAB!2m1!1s0x3403e2de9647ed69:0x622661b3abad88d0"
