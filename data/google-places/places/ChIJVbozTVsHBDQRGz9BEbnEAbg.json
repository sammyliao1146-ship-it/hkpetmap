        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xOa1JtbEpabkEyUXpCUk5YTkdNSEkxWlc5SFZtYxAB!2m1!1s0x3404075b4d33ba55:0xb801c4b911413f1b"
