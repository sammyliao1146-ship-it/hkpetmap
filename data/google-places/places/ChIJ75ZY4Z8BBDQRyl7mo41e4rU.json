        "publishTime": "2025-02-11T11:50:21.564009Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChdDSUhNMG9nS0VJQ0FnTURBZ18zNGp3RRAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnTURBZ18zNGp3RRAB!2m1!1s0x3404019fe15896ef:0xb5e25e8da3e65eca"
