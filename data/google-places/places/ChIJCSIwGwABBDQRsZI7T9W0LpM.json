        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUNmNU9XUVVBEAE!2m1!1s0x340401001b302209:0x932eb4d54f3b92b1"
