        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21ad1RWZHpkREZETVc5UU1ETlhkMmRYVldkT2EwRRAB!2m1!1s0x3403fdc8db32ae8f:0x677b98543e311286"
