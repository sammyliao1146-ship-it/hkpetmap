        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUMxb3BLMlBnEAE!2m1!1s0x3403ff8729c60ec9:0x4d7c20e27bc282c7"
