        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pKQk1ucHRTMHA2TW5adVYxUlRWWGhmVkdkNGVsRRAB!2m1!1s0x3404014f3a82b031:0xb577e5e752b58a23"
