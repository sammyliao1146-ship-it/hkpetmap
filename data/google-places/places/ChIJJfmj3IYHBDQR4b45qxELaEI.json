        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnTURnazRPUTFnRRAB!2m1!1s0x34040786dca3f925:0x42680b11ab39bee1"
