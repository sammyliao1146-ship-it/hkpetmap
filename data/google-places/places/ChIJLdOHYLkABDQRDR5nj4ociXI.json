        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25sU1RVeDRNbGxyVmxscWFXZElWR1ZvYm0xRFNHYxAB!2m1!1s0x340400b96087d32d:0x72891c8a8f671e0d"
