        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xsZk1YRTRjSFp0ZVVKdFpFNXpRVFZvWHpCbFZtYxAB!2m1!1s0x34040146a7b73857:0x6dbfb57f9809543c"
