        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21sbGNFMUhVMDR6VEVGSVZrUlNhSGRVVVVSdVowRRAB!2m1!1s0x340400c0a293d39b:0x10a84b4292ca648b"
