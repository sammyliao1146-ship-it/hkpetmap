        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tvd1lXVnRUalV4T0ZoeE5tZGFlQzFzVDNOeFduYxAB!2m1!1s0x340400d9ab748f1d:0x83ad613ef8907093"
