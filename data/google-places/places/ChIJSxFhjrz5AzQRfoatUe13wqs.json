        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnTUNneG9LbjhBRRAB!2m1!1s0x3403f9bc8e61114b:0xabc277ed51ad867e"
