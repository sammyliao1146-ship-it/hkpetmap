        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xCV1V6QmtTRU5MWDFwcmJGcDNPV0YwWlZoV1ZHYxAB!2m1!1s0x340405ec684b361f:0xe6316f436485605d"
