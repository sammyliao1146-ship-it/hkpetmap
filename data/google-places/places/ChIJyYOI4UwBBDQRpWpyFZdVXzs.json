        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tVdE0weEhSbVpxUzBoeU5VRm9OMjl5ZEZwclJuYxAB!2m1!1s0x3404014ce18883c9:0x3b5f559715726aa5"
