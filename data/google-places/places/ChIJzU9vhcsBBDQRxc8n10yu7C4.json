        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT213eGRXcENlazFsUW5RM1ExSkdhRU5FY20xYVkyYxAB!2m1!1s0x340401cb856f4fcd:0x2eecae4cd727cfc5"
