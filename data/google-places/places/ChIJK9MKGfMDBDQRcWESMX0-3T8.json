        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tGcVZVNDFNVWN6TjJNNFNUWnBjSGc1VDNKT1dVRRAB!2m1!1s0x340403f3190ad32b:0x3fdd3e7d31126171"
