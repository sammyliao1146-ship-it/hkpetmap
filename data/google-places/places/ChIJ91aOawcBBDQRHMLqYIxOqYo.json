          "uri": "https://www.google.com/maps/contrib/100394505126897297906/reviews",
          "photoUri": "https://lh3.googleusercontent.com/a-/ALV-UjUTNuEGodyfjT9FDdxlXS1MFP9qrkucPOawDZD-WJ6nfz1zCX4o0Q=s128-c0x00000000-cc-rp-mo-ba4"
