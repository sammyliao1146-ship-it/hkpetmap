        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21VdFVFWnlRMFl6V0ZsM05uSlFjV1ZhWkZkS1FuYxAB!2m1!1s0x3403f1c928c6d961:0xe6fa7bd32f2d78d4"
