        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21OTWRXOUthSE5IVEVSbGFIbzRVMFowYm1WSVZYYxAB!2m1!1s0x3403ff9b4ab0817f:0xeaf557526f8668bc"
