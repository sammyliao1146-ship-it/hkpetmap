        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tOSVJHbEJSbkV0U0RaR05VNVViRkJmYUc5blEyYxAB!2m1!1s0x3403f9578031ada5:0xcd90d76eaf3a25f5"
