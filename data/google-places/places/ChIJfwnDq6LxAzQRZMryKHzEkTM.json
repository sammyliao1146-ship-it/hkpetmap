        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21GeU5FZ3liMkpFT1RORU9EUkhNbFpQWVRSRk5GRRAB!2m1!1s0x3403f1a2abc3097f:0x3391c47c28f2ca64"
