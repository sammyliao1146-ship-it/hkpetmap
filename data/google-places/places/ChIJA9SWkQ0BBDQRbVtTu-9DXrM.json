        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pSTmJVaEVWRnA2YkZORVpqWm9WbXQ2TkhOc1JIYxAB!2m1!1s0x3404010d9196d403:0xb35e43efbb535b6d"
