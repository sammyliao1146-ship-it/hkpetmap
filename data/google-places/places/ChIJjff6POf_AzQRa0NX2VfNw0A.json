        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xCU2NHMW5hakJZWDBSbmRtOWZSMVZXWkRsaFdYYxAB!2m1!1s0x3403ffe73cfaf78d:0x40c3cd57d957436b"
