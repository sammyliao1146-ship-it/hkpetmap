        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSUQ2aWZuQTh3RRAB!2m1!1s0x3403f9bdcaee0435:0x36416bdb7d3fb005"
