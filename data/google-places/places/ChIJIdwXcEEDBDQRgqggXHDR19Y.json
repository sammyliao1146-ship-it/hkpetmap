        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSUNjcTRuNTVRRRAB!2m1!1s0x340403417017dc21:0xd6d7d1705c20a882"
