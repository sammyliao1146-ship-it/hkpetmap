        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25aSGFXeHpVWGR1YXpGUFMyNVlUM2hSYVRkVlMwRRAB!2m1!1s0x340400f210eda307:0xdcc3172cfcf94000"
