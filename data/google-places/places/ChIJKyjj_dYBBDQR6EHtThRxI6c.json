        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25KYWNFZDVkMUp6ZUU1amRVVTBkbkpmV1dkamVWRRAB!2m1!1s0x340401d6fde3282b:0xa72371144eed41e8"
