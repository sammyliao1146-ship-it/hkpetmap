        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xGUk1DMW9YMmhqWkZoQlMyRjRWVWhEVHpORmEwRRAB!2m1!1s0x34040790ff5c6467:0xb87076a3e038cc79"
