        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSUNwMTU2eDhRRRAB!2m1!1s0x3403fb3a8ab04477:0x25906bea7c23b809"
