        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25NMk16QTNUVTEyTUhnMk9VNWhXRUpSTTBsQk1YYxAB!2m1!1s0x340405de06cae52d:0x88d30dfc6afa9511"
