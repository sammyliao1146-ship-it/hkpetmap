        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSUM1cE5iVW5BRRAB!2m1!1s0x3403f92dac9a74d7:0xd7de22ca7df9d9c8"
