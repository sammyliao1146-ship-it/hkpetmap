        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25ScFlreExTMGhKVjJveUxWVTJXVkJuVkRaWGRGRRAB!2m1!1s0x3404010023c3122f:0xc3a6e833c434b0fd"
