        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xwaWFUUlRRbGRCWW5oVWRFcExWbmwyVDNoSlVIYxAB!2m1!1s0x3404075980550895:0xdb413f2fc376538f"
