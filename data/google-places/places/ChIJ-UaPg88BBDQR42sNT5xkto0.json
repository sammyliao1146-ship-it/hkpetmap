        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25GbWVrZ3haRkJOVG1oVU56SlJjMWgzUjNaR1dYYxAB!2m1!1s0x340401cf838f46f9:0x8db6649c4f0d6be3"
