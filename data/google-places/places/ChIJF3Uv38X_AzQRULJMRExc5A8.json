        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT214clFUazJaRTlZYmpZeFowaElhemxTYm5KM2FsRRAB!2m1!1s0x3403ffc5df2f7517:0xfe45c4c444cb250"
