        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xaaE1qUlFTV2g1U1VKalIycG1iRVp6YzFCTldsRRAB!2m1!1s0x3403f9005d3f12cf:0x1c537ed9f21b24a4"
