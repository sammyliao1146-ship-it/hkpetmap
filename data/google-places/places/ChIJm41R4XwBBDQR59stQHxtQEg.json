        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xaZmRpMW9ZV04zUkRKaU0yeENVM3BwVldaTmNuYxAB!2m1!1s0x3404017ce1518d9b:0x48406d7c402ddbe7"
