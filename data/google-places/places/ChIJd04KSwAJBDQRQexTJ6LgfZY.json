        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT20xcVZtbEJRazlYY0V0VVRrbDBVbkY2TjJaeWFtYxAB!2m1!1s0x340409004b0a4e77:0x967de0a22753ec41"
