        "publishTime": "2024-03-20T03:29:44.916908Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChdDSUhNMG9nS0VJQ0FnSUQ5bmZLU2lBRRAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSUQ5bmZLU2lBRRAB!2m1!1s0x340407f6a3d4cd91:0xd3727b94f4962d4d"
