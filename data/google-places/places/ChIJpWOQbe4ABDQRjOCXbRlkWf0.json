        "publishTime": "2026-07-04T10:14:43.345124406Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2tzM1IyOHhWakJxT1VWTFVrVlVSM1UwTTNOM1ZHYxAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tzM1IyOHhWakJxT1VWTFVrVlVSM1UwTTNOM1ZHYxAB!2m1!1s0x340400ee6d9063a5:0xfd5964196d97e08c"
