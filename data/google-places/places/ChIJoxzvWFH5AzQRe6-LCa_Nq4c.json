        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25BdE1FRTVURFp6TVRSQlUxQjFjR0pRTlZOVU4zYxAB!2m1!1s0x3403f95158ef1ca3:0x87abcdaf098baf7b"
