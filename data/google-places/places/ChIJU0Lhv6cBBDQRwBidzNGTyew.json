        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSURYenVpb1BBEAE!2m1!1s0x340401a7bfe14253:0xecc993d1cc9d18c0"
