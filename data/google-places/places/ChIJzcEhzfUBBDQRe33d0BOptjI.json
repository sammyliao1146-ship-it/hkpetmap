        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xOTWVYWllTbTkyWjJoYUxVcExjRk5UVTJKaVRFRRAB!2m1!1s0x340401f5cd21c1cd:0x32b6a913d0dd7d7b"
