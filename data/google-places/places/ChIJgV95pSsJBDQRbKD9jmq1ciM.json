        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2taQlkyWjNjMGQzUkdSMk1HaE5TRzlxVDFobVdIYxAB!2m1!1s0x3404092ba5795f81:0x2372b56a8efda06c"
