        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21SeWVFUnpjR1pJWkdGM1IxOHRRVzlYUW1sd1ZGRRAB!2m1!1s0x3403e33ba4e8ddf9:0xeae18a9693807197"
