        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2kxdFRHcHhORWxTTFhBMGR6ZGxNalp1UmxSVk9XYxAB!2m1!1s0x340401eb1cb59a6f:0xc68476c7374325e6"
