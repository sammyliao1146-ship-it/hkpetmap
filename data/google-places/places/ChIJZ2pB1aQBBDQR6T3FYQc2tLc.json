        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2w4MlV6Wk1TRXBoY0RKTVN6QmhhR05hZFVOTGJFRRAB!2m1!1s0x340401a4d5416a67:0xb7b4360761c53de9"
