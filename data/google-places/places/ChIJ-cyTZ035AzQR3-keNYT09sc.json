        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xCT1ZrdzNRMWR0T0VGQmRuVm1MVzR0T1ZwWVgxRRAB!2m1!1s0x3403f94d6793ccf9:0xc7f6f484351ee9df"
