        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tSZlR5MVhORzh6TkRGd1FuaGhiazk0T0Y5bFJsRRAB!2m1!1s0x340400597e30c823:0xec575dfc4000257c"
