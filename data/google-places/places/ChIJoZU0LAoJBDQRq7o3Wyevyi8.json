        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xKSE0wVk1NbEY2VDBKbkxUSlhMVzgwY0hCWlVWRRAB!2m1!1s0x3404090a2c3495a1:0x2fcaaf275b37baab"
