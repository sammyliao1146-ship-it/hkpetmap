        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VPQ0F1b2JPdUtqOWhnRRAB!2m1!1s0x3404033b1218137d:0xe5de385076f50d2d"
