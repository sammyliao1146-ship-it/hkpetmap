        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xKcVdUUkJjSFF6UzIxc1EzcEtaRWRVY0hrMVYyYxAB!2m1!1s0x3403f9ee0b9c350f:0x767ec9aa7dda99ae"
