        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VQMzZ2Y21FaGVLbk5nEAE!2m1!1s0x340157e86ebfc5c3:0xa5756983b11f3c68"
