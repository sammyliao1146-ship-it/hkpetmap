        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pkVlNqVndUUzF2VkVzeVZHdG9iRFprYWpJMk5rRRAB!2m1!1s0x3404014cda3c6301:0xe144e19d34e07878"
