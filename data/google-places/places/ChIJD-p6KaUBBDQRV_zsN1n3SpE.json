        "publishTime": "2025-03-18T13:33:38.199031Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChdDSUhNMG9nS0VJQ0FnTUN3eHBHZTBnRRAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnTUN3eHBHZTBnRRAB!2m1!1s0x340401a5297aea0f:0x914af75937ecfc57"
