        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tSSGNYUnBMVVZYWm1nM2JIbFNkVk5ZU0ZKQlkyYxAB!2m1!1s0x34040f007e5bb1bb:0x9bdedf8e732e10a"
