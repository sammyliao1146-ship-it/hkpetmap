        "publishTime": "2025-09-27T14:18:25.780854975Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT21OZlNrMHplV2xPZFc1eVZtaHFaR1UzVEdScVNuYxAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21OZlNrMHplV2xPZFc1eVZtaHFaR1UzVEdScVNuYxAB!2m1!1s0x3403ff80be0cffff:0xa7327610bad86c5d"
