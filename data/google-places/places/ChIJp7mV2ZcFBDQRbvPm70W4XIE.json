          "photoUri": "https://lh3.googleusercontent.com/a/ACg8ocJWuBYa8wOuzKKmLeA45dWCUNxAUw1SFiXvJMG2FO1y5bPLIA=s128-c0x00000000-cc-rp-mo-ba6"
