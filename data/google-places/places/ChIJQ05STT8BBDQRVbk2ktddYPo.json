        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSUNSLU5uVjhnRRAB!2m1!1s0x3404013f4d524e43:0xfa605dd79236b955"
