        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2t4clkyMXRNR1ZuY0V0WmNYQlRRMnRqWkV3NVZuYxAB!2m1!1s0x3403fb1f6381481b:0xe82fc2904c33d529"
