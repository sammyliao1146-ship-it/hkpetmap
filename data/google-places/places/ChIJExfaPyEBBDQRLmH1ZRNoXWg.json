        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21Sd1pUazFPR1pFUTJ0cmJXOXFZVlYyYlZCSVdYYxAB!2m1!1s0x340401213fda1713:0x685d681365f5612e"
