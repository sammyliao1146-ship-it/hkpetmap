        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25SZmFVZGxhRVkyWDFOd1RXa3pWMDFzTFdGM1VuYxAB!2m1!1s0x34040360d87f6a11:0x3b8e61ad72fc53d8"
