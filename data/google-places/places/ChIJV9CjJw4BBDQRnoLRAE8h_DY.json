        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xSSU5sSTBXbmxEVVd0emFWTlNhREUwTTBaVlJtYxAB!2m1!1s0x3404010e27a3d057:0x36fc214f00d1829e"
