        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21kb1FuWkdNVzkzYkZndFQzcGhZVGszVG5oUVEzYxAB!2m1!1s0x34040108c3f2fd8f:0xf115749e9d943ae4"
