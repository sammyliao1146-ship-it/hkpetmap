        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT20xYWJIcFhNWGgxVjFsdlgyOVJkRkpYYnpkd1UzYxAB!2m1!1s0x340401b28f30a8f5:0x7f525212542d2b28"
