        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2s5U1ZEZEJUMFpJUldRM2EzUkJURE40WmpabFJWRRAB!2m1!1s0x340400bafc68a7af:0x8c597631b8b12d39"
