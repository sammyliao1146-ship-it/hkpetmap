        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xWYVVIcFRNbDlNUlc1b1JtSk9lWEV4TXpWNVJrRRAB!2m1!1s0x34040056f4f00001:0x8b9cd06d6c1c00a"
