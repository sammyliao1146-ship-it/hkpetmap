        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSUM5ekxfYXRRRRAB!2m1!1s0x34040100415061df:0x660bbae2fa1069e2"
