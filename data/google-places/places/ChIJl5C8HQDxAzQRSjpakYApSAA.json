        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21sRE5FeERaM2xEVFdaM1N6QkRaVmMxYzBoU01HYxAB!2m1!1s0x3403f1001dbc9097:0x482980915a3a4a"
