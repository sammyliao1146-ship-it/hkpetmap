        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21WVGRVMXNXRFl6UW5BM1gyOXVSVFJLV2xCdVEwRRAB!2m1!1s0x34040176fced5b73:0xcb064de077eda5eb"
