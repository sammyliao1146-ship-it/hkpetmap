        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSUNXenVyWXZRRRAB!2m1!1s0x3403fbaa55def913:0x5d1108b0dd3fbe16"
