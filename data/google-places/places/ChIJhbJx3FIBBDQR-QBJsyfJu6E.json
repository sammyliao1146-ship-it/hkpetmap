        "publishTime": "2026-01-10T16:11:37.383592381Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT25CS2VYTnZZa0ZsUkdKV1NXNTFTRmx1UzAweU4xRRAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25CS2VYTnZZa0ZsUkdKV1NXNTFTRmx1UzAweU4xRRAB!2m1!1s0x34040152dc71b285:0xa1bbc927b34900f9"
