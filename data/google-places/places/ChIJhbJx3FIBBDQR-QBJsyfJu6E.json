        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25ZMGVtRjFUVmRPT1d4V1kwaDVVSE5zYmw5bFVYYxAB!2m1!1s0x34040152dc71b285:0xa1bbc927b34900f9"
