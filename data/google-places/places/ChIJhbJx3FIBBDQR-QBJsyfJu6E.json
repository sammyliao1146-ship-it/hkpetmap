        "publishTime": "2026-07-08T11:52:45.135342224Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2xaT01EbFRPRXhxTlRnM1FVcHFXbVZKYlVrMVNtYxAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xaT01EbFRPRXhxTlRnM1FVcHFXbVZKYlVrMVNtYxAB!2m1!1s0x34040152dc71b285:0xa1bbc927b34900f9"
