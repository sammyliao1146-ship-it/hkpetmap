        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xkaGR6SkNjak5uZW1odGJVd3lVVFJpWkRGamNVRRAB!2m1!1s0x34040746c1053975:0xa587b3b8379cb1e2"
