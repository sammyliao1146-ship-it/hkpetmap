          "photoUri": "https://lh3.googleusercontent.com/a-/ALV-UjV_No7cU_wSLesqsp2MzKbZEIla4LN_ndebYKZ73MTs_1U2Npxm=s128-c0x00000000-cc-rp-mo-ba5"
