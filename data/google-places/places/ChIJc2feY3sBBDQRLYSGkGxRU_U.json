        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25ORFltdE9UVGRCWldSZmVrMW9TbkpCVDFVMlkwRRAB!2m1!1s0x3404017b63de6773:0xf553516c9086842d"
