        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xwdlMzZE1aSEpIZUZweVdHZzBiR3B0VG1Sa2IyYxAB!2m1!1s0x3404018409b8666f:0xa34cd7e9df463f34"
