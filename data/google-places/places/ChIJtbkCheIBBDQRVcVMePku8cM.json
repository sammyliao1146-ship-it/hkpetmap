        "publishTime": "2026-07-13T06:24:14.250593848Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT25sQlgzRk9TVGhVVTJnM1NUQmtiRUY2WDBKaWRXYxAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25sQlgzRk9TVGhVVTJnM1NUQmtiRUY2WDBKaWRXYxAB!2m1!1s0x340401e28502b9b5:0xc3f12ef9784cc555"
