        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xJdGRGTTFTV1ZIT1ROQk9XRnNTVU42ZWtGU1MyYxAB!2m1!1s0x3404009073ba01e3:0xd0f7e713fb8495cc"
