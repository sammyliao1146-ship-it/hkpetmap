        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnTUR3N0pTVU53EAE!2m1!1s0x3404074d40405327:0x701b5332ed5e5b10"
