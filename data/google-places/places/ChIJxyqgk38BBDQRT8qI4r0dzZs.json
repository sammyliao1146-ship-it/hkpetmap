        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xOUmF6TlBVM281ZGtWU01tVjZaMlYyYUdjd09IYxAB!2m1!1s0x3404017f93a02ac7:0x9bcd1dbde288ca4f"
