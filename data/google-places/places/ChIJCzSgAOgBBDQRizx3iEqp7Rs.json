        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25OWlVEQkZlSHBGVEZkUFJGcDBPV2czVFMxalZVRRAB!2m1!1s0x340401e800a0340b:0x1beda94a88773c8b"
