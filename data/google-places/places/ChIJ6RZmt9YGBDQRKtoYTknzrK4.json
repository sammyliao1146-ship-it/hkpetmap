        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSUMtZ003VXZBRRAB!2m1!1s0x340406d6b76616e9:0xaeacf3494e18da2a"
