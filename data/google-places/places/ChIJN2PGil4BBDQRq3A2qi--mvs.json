        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2psV1l6TnJUMnByT0RWUFRsbFRja0ZPWkZkdlVFRRAB!2m1!1s0x3404015e8ac66337:0xfb9abe2faa3670ab"
