        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2podU9WazRWUzFwWkVGS1JITmFlalp4ZHpKd1VYYxAB!2m1!1s0x340401f09ceab4b5:0x22748ce2cf9173a8"
