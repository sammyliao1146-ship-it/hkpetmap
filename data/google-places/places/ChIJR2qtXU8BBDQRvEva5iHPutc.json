        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnTUR3M3M3RXdBRRAB!2m1!1s0x3404014f5dad6a47:0xd7bacf21e6da4bbc"
