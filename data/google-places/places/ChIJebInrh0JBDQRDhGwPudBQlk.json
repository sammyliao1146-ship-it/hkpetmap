        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21sd056Rm1UMTgyVVVNMFdFOTBNMlJxZW1OR00yYxAB!2m1!1s0x3404091dae27b279:0x594241e73eb0110e"
