        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2psMmRsRm9Va2xsVG05bVFYb3djWEYxTlhaVWNIYxAB!2m1!1s0x3403fff59312b8d9:0x8960eaf13da4874f"
