        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25kNWVqUXhaRU5JWDBGeGJHSjNNWFZ2YzJJeVJVRRAB!2m1!1s0x3404010f18a2d97f:0x3b872184d54028de"
