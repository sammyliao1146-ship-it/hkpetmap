        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pKdlZWaE1lbFp6ZFdSelVHSnZSRzkxVDJ4WlZFRRAB!2m1!1s0x3403e375b2844e4f:0x202ea00a02fea978"
