        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xOd1EzZHNYMlJmWlZaMFpHdzVORkZJVVhnd2NWRRAB!2m1!1s0x34040180788ae13d:0x71aacca4b7c3da11"
