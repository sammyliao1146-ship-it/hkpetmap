        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT21FNVZFaEpTbEJxTWpaQ2FubFBabEZJYkdZeFYxRRAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21FNVZFaEpTbEJxTWpaQ2FubFBabEZJYkdZeFYxRRAB!2m1!1s0x34040180788ae13d:0x71aacca4b7c3da11"
