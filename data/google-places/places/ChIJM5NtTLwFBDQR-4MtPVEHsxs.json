        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2s5aVMyWnNSMjFMVlVwWVdGRklSVU14WTBwNk4yYxAB!2m1!1s0x340405bc4c6d9333:0x1bb307513d2d83fb"
