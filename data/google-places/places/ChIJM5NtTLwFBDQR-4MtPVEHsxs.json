        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25BelJVdExRV2xZYzNSQlJrWnhUV3A2ZUd4RlJVRRAB!2m1!1s0x340405bc4c6d9333:0x1bb307513d2d83fb"
