        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25jM05sWnZkV3BFUjNsNFQzazRWREI1YkdVMFZWRRAB!2m1!1s0x3403ff9a5f55858d:0xf7c220fd3cda1ad"
