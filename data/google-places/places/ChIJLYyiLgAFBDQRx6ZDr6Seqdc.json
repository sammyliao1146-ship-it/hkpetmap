        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJekZ3TTZzNjZIQmN3EAE!2m1!1s0x340405002ea28c2d:0xd7a99ea4af43a6c7"
