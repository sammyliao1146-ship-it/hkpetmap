        "publishTime": "2022-01-28T16:14:08.666025Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChdDSUhNMG9nS0VJQ0FnSURtenE3MWpnRRAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSURtenE3MWpnRRAB!2m1!1s0x3403ff56ca03fbe7:0xfcdd17d03536abb"
