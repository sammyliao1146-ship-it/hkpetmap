        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tOWWVsRnFPR2RhVTJkUVVtOUxMVk4wYzBGUlpFRRAB!2m1!1s0x3403f16d105c40f1:0xec2cfce1bc945922"
