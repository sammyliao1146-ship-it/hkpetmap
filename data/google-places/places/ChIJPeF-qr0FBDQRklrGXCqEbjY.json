          "languageCode": "zh-Hant"
        },
        "authorAttribution": {
          "displayName": "Cara Yeung",
          "uri": "https://www.google.com/maps/contrib/105939776497139858120/reviews",
          "photoUri": "https://lh3.googleusercontent.com/a-/ALV-UjWi5znMGuQhYXGPFPUUtMYLhdPcykYtXPi2EC5_S87brhSIwJkL=s128-c0x00000000-cc-rp-mo-ba4"
        },
        "publishTime": "2025-10-12T17:27:51.773708290Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2xsalZHczNSRFEzZW1kUU1HdDVabUZoYURjdFFuYxAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xsalZHczNSRFEzZW1kUU1HdDVabUZoYURjdFFuYxAB!2m1!1s0x340405bdaa7ee13d:0x366e842a5cc65a92"
