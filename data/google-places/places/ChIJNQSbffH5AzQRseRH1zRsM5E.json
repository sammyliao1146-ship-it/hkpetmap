        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2xaWk1qbEpXRlU0YlMxaFZrbDVXazFzYzBRMGFGRRAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xaWk1qbEpXRlU0YlMxaFZrbDVXazFzYzBRMGFGRRAB!2m1!1s0x3403f9f17d9b0435:0x91336c34d747e4b1"
