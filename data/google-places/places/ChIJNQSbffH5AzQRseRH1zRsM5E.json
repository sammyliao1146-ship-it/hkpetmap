        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tFMlFXa3plbVJpZDNGUFoycDVVbmxtU0hsalNHYxAB!2m1!1s0x3403f9f17d9b0435:0x91336c34d747e4b1"
