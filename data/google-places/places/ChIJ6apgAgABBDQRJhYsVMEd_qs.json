        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21NNVRHMWhWMFJqTkVseVZWWmFaSE55VEVaT2FHYxAB!2m1!1s0x340401000260aae9:0xabfe1dc1542c1626"
