        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSURWNDlydDVnRRAB!2m1!1s0x3403ff837c79738d:0x5eef73463cec1cff"
