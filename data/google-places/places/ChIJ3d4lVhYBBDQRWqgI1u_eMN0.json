        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSUR0cElubDhnRRAB!2m1!1s0x340401165625dedd:0xdd30deefd608a85a"
