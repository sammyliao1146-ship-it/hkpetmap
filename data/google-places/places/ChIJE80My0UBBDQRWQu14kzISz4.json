        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2s1cmRqUmxWRWxxYmpoNVMyNDVXR2s0UjJWcFNuYxAB!2m1!1s0x34040145cb0ccd13:0x3e4bc84ce2b50b59"
