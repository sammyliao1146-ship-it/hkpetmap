        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pKbk5VUXdUM1JCVjNaSFIzUkZSR1phUTNkamNsRRAB!2m1!1s0x340407004799de2b:0x6dc4721b66d9fee9"
