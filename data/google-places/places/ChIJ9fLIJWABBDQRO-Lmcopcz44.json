        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2twTU9YWlpZbXBzVFhnM2EzVjBWbGxSVGxrM1ZGRRAB!2m1!1s0x3404016025c8f2f5:0x8ecf5c8a72e6e23b"
