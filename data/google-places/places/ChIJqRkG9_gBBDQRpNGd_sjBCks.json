        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pBNVZtRTNZWEJLY0c1T2MzUkpibEZNUTFOSWFrRRAB!2m1!1s0x340401f8f70619a9:0x4b0ac1c8fe9dd1a4"
