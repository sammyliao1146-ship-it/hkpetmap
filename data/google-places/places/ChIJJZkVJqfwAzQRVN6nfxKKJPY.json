        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21nMlNuSXhlSEpWV2pBeFNFUlJaelZLT0MxRlozYxAB!2m1!1s0x3403f0a726159925:0xf6248a127fa7de54"
