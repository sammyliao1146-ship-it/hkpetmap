        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2s5MmRXZG1ka2xqU1VoUFRqTXRSMk42Y2tFd1NGRRAB!2m1!1s0x340401f0408957cb:0x36566d34144eef02"
