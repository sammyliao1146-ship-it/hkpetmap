        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25wRVRuTkZjbEpXUkcxblVsY3RhekZ0TW5KcVowRRAB!2m1!1s0x340401f0408957cb:0x36566d34144eef02"
