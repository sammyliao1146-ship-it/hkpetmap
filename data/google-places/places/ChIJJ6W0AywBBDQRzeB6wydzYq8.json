        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pkcGNXdEtTeTFvWDFOaFdFaEJaVzFVZVhoWFFsRRAB!2m1!1s0x3404012c03b4a527:0xaf627327c37ae0cd"
