        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25kUWNrTkhURkJ5UzFsSk9GcFhYMUpUWVhFNFltYxAB!2m1!1s0x3403ff85e50cb71f:0x3c245b35e4848733"
