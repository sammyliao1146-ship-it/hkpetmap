        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUNiNnBxWEpREAE!2m1!1s0x340401d76d375841:0x3ebceacf6e93e3be"
