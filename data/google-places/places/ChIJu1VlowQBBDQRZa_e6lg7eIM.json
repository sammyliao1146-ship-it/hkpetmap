        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pod2RXUjZNVVpRUVdkVVRrWTRka3h5UVVSTU1HYxAB!2m1!1s0x34040104a36555bb:0x83783b58eadeaf65"
