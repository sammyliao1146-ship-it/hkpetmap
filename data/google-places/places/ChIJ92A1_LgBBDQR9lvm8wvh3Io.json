        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25CWmVFSnJlV2M1UTB0b2MzcHdWMHB0VW1JMk1IYxAB!2m1!1s0x340401b8fc3560f7:0x8adce10bf3e65bf6"
