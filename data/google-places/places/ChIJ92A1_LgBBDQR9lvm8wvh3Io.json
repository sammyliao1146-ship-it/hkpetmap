        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2pnM1FYUXpORzkzT1dkS1luUjNielowUzJOVWNHYxAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pnM1FYUXpORzkzT1dkS1luUjNielowUzJOVWNHYxAB!2m1!1s0x340401b8fc3560f7:0x8adce10bf3e65bf6"
