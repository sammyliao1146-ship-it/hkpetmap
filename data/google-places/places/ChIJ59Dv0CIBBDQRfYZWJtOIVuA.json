        "publishTime": "2026-08-10T08:54:00.465768152Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2xsbGNqbFRXR3BGU1hwWE1rc3pNRk0zVjNoeU5WRRAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xsbGNqbFRXR3BGU1hwWE1rc3pNRk0zVjNoeU5WRRAB!2m1!1s0x34040122d0efd0e7:0xe05688d32656867d"
