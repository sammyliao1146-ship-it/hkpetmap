        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2psQldFaGlhblJSTUZSVE1VeFVNakU1ZFdSeWVIYxAB!2m1!1s0x3403fc2f11311fc7:0xa716b848aa9a0ff0"
