        "publishTime": "2022-09-15T10:41:33.219460Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChZDSUhNMG9nS0VJQ0FnSUNlX3I3dkNnEAE&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUNlX3I3dkNnEAE!2m1!1s0x3404012739174493:0x3152ce74de179ad4"
