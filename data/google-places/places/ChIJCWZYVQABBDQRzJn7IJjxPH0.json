        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xKeWFISlpRVmsxWldoRWVUZHdNMjU2VEVkYU0wRRAB!2m1!1s0x3404010055586609:0x7d3cf19820fb99cc"
