        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2t4QlVVOW9TMjFDZHpGaFlqTkVXSEEwWHpOQ1FYYxAB!2m1!1s0x3404019b1f506297:0x70d19b828449221a"
