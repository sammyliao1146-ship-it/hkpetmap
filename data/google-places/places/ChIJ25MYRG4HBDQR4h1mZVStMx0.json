        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25BMGJtMTNTMDFhUkdWMWVrbEVXREpuY2tocVVGRRAB!2m1!1s0x3404076e441893db:0x1d33ad5465661de2"
