        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xkWmRFTklSblE0TVdWamVIaE9aVWRpTm5vMk1tYxAB!2m1!1s0x340400b34c851b81:0x20b957cf5001a943"
