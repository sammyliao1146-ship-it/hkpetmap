        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21aSmNIWmtkVVpSU1haS2RUTmxTV3BZVDNwUVdXYxAB!2m1!1s0x3404078b63f37b0d:0x371f950c8ad7ed01"
