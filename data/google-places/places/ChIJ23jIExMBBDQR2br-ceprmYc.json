        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25Gc04zaERabXhZYnpCS1IzVTFibmgyUW5oek9WRRAB!2m1!1s0x3404011313c878db:0x87996bea71febad9"
