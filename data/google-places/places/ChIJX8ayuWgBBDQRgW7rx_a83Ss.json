        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnTUNBcVozRUJnEAE!2m1!1s0x34040168b9b2c65f:0x2bddbcf6c7eb6e81"
