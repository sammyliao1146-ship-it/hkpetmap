        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUR4bE1QemZREAE!2m1!1s0x34040112c4fd076b:0x5d6a46ba25d135a5"
