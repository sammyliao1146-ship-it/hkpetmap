        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25KVGNsQkRTbm8yYWpWV05teHJkMkpJT0hGeVlrRRAB!2m1!1s0x3404007b82aa97ab:0x85472ab65ca91b03"
