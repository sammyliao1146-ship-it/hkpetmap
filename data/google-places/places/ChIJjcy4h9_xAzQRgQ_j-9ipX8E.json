        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xCMlkzcGhRMDlPWm1wNU1FUmpRa3hOYUdWZlYwRRAB!2m1!1s0x3403f1df87b8cc8d:0xc15fa9d8fbe30f81"
