        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT214MVNERkJWbEEzVDNCbVQxQjJjMmhVYW5KUGRYYxAB!2m1!1s0x340401e2b030ef5b:0xc0c91a9ce5465282"
