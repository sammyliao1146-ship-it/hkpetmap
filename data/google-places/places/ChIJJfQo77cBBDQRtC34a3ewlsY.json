        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xwblZIQldUVk4zUnpkeE5WSkVkbTFEV0ZCNlMxRRAB!2m1!1s0x340401b7ef28f425:0xc696b0776bf82db4"
