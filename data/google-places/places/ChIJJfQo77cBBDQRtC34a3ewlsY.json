        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT21WeWJHY3daemh6WjA5UlJHZE1TazFaUlVoVWVFRRAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21WeWJHY3daemh6WjA5UlJHZE1TazFaUlVoVWVFRRAB!2m1!1s0x340401b7ef28f425:0xc696b0776bf82db4"
