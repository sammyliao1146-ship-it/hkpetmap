        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xkM2NFNUxXRUZmUVRCdFN6aEhURWxxWVdKR2FGRRAB!2m1!1s0x3404016bea972d4b:0xcea390537970e445"
