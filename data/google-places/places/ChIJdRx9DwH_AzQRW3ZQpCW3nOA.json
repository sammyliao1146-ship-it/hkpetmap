        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tNM2JURnVNR2gyYURaSGQwZFdPV1pRYlVsdloxRRAB!2m1!1s0x3403ff010f7d1c75:0xe09cb725a450765b"
