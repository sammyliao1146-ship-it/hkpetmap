        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21vdFpqTlZiR1JHV0hGMk9ETXRSamxQVlVaQ1QwRRAB!2m1!1s0x340401005b8e992d:0x915b4bc882c9018f"
