        "publishTime": "2017-10-27T10:56:58.311Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChZDSUhNMG9nS0VJQ0FnSURBNEtDTVpREAE&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSURBNEtDTVpREAE!2m1!1s0x34040043bfeb2a1b:0x23ff7957b445f79f"
