        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT213NVZFazVPVjlZT0doNVFVRkRXR1pHZVhsYVQzYxAB!2m1!1s0x3404011d000a92b5:0x955ffd58aaebc667"
