        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25CTVkydzFVVTg0TjFWNVpYWnVRelJQU1hCUU5sRRAB!2m1!1s0x34040753d79c1f29:0xf55963b21872df82"
