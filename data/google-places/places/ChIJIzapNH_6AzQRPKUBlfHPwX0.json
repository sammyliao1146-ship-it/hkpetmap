        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25wSFlsQnROSEpOV2xwUFNWbGFWbGxEUldGM1JuYxAB!2m1!1s0x3403fa7f34a93623:0x7dc1cff19501a53c"
