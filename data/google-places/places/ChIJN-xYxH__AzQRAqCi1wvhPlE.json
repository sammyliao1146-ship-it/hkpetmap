        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2psb1YwMU9XbXhvYUhwd1MycFlYM2ROYnpKSVNsRRAB!2m1!1s0x3403ff7fc458ec37:0x513ee10bd7a2a002"
