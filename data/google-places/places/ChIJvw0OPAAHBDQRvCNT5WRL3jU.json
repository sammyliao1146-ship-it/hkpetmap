        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2sxUlVqRnlXbFJmWm5oaVkwSm5ObU4yUTNsME4xRRAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2sxUlVqRnlXbFJmWm5oaVkwSm5ObU4yUTNsME4xRRAB!2m1!1s0x340407003c0e0dbf:0x35de4b64e55323bc"
