        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT210WGJGaERSMGx1UzFObldVWlJWRE5JYUdoc2FFRRAB!2m1!1s0x340407003c0e0dbf:0x35de4b64e55323bc"
