        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2pCVlRIWndaVlo1YVd0U04weEdibk5UUzJRNVoyYxAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pCVlRIWndaVlo1YVd0U04weEdibk5UUzJRNVoyYxAB!2m1!1s0x3403fba149d81ed9:0x1749775ca46d3e03"
