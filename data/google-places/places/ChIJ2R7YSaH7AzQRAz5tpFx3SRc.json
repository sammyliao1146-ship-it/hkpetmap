        "publishTime": "2026-08-05T16:32:03.403192548Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2pVNUxVZEZaQzB3V2pWWmFWQkJjREJ3Y0VSM2VYYxAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pVNUxVZEZaQzB3V2pWWmFWQkJjREJ3Y0VSM2VYYxAB!2m1!1s0x3403fba149d81ed9:0x1749775ca46d3e03"
