        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21oRWNVSjBUMjlOVUU0NU9HSjRObTlPUzBOVVZIYxAB!2m1!1s0x3403f1301e3e5fe3:0xf6a7a94f4a3b7ead"
