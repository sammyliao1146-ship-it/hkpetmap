        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUM0NElQVGFREAE!2m1!1s0x3404010019668301:0xeaf10ccdd9b8461d"
