        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2t4YVRFUm5WV1pyVHpoSFVsQkNlVXhCVUd4RWFrRRAB!2m1!1s0x3406aa6cc35bef15:0xdd85f16df4b24c5d"
