        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xsWVYwTlZUbGt5YVhSQ2FrcDZYM1JVUlhCelpVRRAB!2m1!1s0x3403ff90b1795c07:0xd5c18206bbda4465"
