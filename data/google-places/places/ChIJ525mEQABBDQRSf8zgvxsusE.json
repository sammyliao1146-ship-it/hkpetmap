        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT201Vk9HcHhha2hJTW5kUFNtYzNZbkUyWjBvMExVRRAB!2m1!1s0x3404010011666ee7:0xc1ba6cfc8233ff49"
