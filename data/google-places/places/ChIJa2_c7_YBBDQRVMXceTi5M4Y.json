        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUNUaTliREpREAE!2m1!1s0x340401f6efdc6f6b:0x8633b93879dcc554"
