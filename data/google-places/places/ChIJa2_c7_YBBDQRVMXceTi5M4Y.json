        "publishTime": "2022-02-18T12:35:58.442266Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChZDSUhNMG9nS0VJQ0FnSUNXcEt6NVFBEAE&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUNXcEt6NVFBEAE!2m1!1s0x340401f6efdc6f6b:0x8633b93879dcc554"
