        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2tod1VrWkJZWEJOU1ZCeWNHcEthREJ2ZFZGUmIxRRAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tod1VrWkJZWEJOU1ZCeWNHcEthREJ2ZFZGUmIxRRAB!2m1!1s0x3404013051bc5815:0x1aeeb72e170aa2f9"
