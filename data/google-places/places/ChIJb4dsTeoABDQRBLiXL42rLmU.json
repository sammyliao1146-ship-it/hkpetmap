        "publishTime": "2026-06-10T14:19:04.950223883Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2kxVWRHUmtSM0pwVnpoWlJ6RldURTVyV1dsWU1HYxAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2kxVWRHUmtSM0pwVnpoWlJ6RldURTVyV1dsWU1HYxAB!2m1!1s0x340400ea4d6c876f:0x652eab8d2f97b804"
