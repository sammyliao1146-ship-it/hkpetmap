        "publishTime": "2024-07-16T11:03:38.307888Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChZDSUhNMG9nS0VJQ0FnSURya3Ezd0ZnEAE&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSURya3Ezd0ZnEAE!2m1!1s0x340400ee15c8d44f:0x399dc0ecbbed247d"
