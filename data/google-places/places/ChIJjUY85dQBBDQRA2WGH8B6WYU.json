        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25VMlprOUxlR0Z4ZDNKWFdHcFpaRjlQYkZwRlZtYxAB!2m1!1s0x340401d4e53c468d:0x85597ac01f866503"
