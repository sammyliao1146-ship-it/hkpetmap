        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xOQ2NWcGFhRmR0TlRnNVNtcHFTVTFvUzJKNFUxRRAB!2m1!1s0x340401002908912f:0x97fddc3ba718c12e"
