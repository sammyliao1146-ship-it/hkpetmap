        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pkdGJITmtNMDlJZERaMFEwWjZRazVMWkcxaGMwRRAB!2m1!1s0x3404019f54e9012f:0x4e17007d0a81bc1d"
