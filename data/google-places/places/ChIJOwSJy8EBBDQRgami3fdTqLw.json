        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pSbFpFcHdhVVU1V1dKMFFuaEtibkpRVjFaWU5uYxAB!2m1!1s0x340401c1cb89043b:0xbca853f7dda2a981"
