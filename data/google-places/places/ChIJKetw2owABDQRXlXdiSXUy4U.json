        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnTUR3MmRHVVVBEAE!2m1!1s0x3404008cda70eb29:0x85cbd42589dd555e"
