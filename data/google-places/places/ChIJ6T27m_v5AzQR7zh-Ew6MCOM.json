        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pGSE0yaHVSVVpuWXpaTGVuVXhlRGsyU25SMWIxRRAB!2m1!1s0x3403f9fb9bbb3de9:0xe3088c0e137e38ef"
