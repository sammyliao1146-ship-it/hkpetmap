        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25kcGRrNTRZMDFxTUU5MGJHRkRkMFIxTVMxRlpXYxAB!2m1!1s0x340400569a2f7f57:0xfaadacad9e0fddb2"
