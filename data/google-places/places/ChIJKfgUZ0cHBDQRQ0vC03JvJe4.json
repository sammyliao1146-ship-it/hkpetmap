        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSURXbVBfZGZ3EAE!2m1!1s0x340407476714f829:0xee256f72d3c24b43"
