        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xOMWR6WTFYM3B0VjFsVE5HRlhVbXRQZUhaSmRuYxAB!2m1!1s0x34040053ee39bc9d:0x167ebac38a829d9"
