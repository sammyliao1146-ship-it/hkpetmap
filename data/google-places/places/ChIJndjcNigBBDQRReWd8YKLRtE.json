        "publishTime": "2024-10-08T08:54:12.902558Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChZDSUhNMG9nS0VJQ0FnSURudGF6M0VnEAE&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSURudGF6M0VnEAE!2m1!1s0x3404012836dcd89d:0xd1468b82f19de545"
