        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSURueWF1UkhBEAE!2m1!1s0x3404012836dcd89d:0xd1468b82f19de545"
