        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2t4d1VtRk5SVE5UVWxCM05WVXdXWEowZUZsRE9GRRAB!2m1!1s0x3404010d9542d573:0x46562279909eec1c"
