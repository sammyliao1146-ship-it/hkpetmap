        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21kd1RtaHVOM2c0U2taWFpFUkRVMWM1V1Zsd09HYxAB!2m1!1s0x3403fa0a87095555:0x6607581cec3ca3cd"
