        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnTURRMzZ1cU1REAE!2m1!1s0x340400b6c873d89b:0x36f3553124393137"
