        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT214a2NHTk1jelE0TTBkdWNtVkJXbWh2WkhaSVpXYxAB!2m1!1s0x3403f1c0f83dc061:0x5235e5cea3aefff7"
