        "publishTime": "2026-05-05T09:09:50.472868465Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2xKdWVGWlRlbTVaVWxsWk4wSXliVVJzWWtKUWNtYxAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xKdWVGWlRlbTVaVWxsWk4wSXliVVJzWWtKUWNtYxAB!2m1!1s0x34040131d26f2503:0x16112ee724981982"
