        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21NNWRYVTFibnA1YzJkT1gzY3dkRGN0TVdWWFgwRRAB!2m1!1s0x3404070057a3ef99:0x68d57fbad460846"
