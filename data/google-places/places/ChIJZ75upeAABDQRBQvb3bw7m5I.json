        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xWNmJXTkpTMVJUWlhselJXWXhPRVZIYkV4Qk4yYxAB!2m1!1s0x340400e0a56ebe67:0x929b3bbcdddb0b05"
