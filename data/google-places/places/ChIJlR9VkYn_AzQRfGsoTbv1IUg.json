        "publishTime": "2026-08-12T00:51:53.337064358Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT25CV2MybzJkbkJpVlZjemVsVm5MVWRVTTFCTmEyYxAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25CV2MybzJkbkJpVlZjemVsVm5MVWRVTTFCTmEyYxAB!2m1!1s0x3403ff8991551f95:0x4821f5bb4d286b7c"
