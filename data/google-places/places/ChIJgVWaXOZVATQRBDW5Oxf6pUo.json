        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tkbFkySTRabGx5ZDFod1FVdFhNa3hCYkZOa1drRRAB!2m1!1s0x340155e65c9a5581:0x4aa5fa173bb93504"
