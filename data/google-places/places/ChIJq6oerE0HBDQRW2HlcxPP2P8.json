        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tJMVdGTkxWRTlIY1VWTGExVnFaMWRUWjFKaFVYYxAB!2m1!1s0x3404074dac1eaaab:0xffd8cf1373e5615b"
