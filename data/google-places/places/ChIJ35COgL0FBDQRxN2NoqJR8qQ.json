        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xCMFdVZEtWa0p1V1hFMmQyOWphREpTZEU1eVRGRRAB!2m1!1s0x340405bd808e90df:0xa4f251a2a28dddc4"
