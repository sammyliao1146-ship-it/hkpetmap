        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xsMkxVbHpaVTA0ZGpOd1pHTmhURmRqTUZOQlIxRRAB!2m1!1s0x3404014838f249bd:0x3310722f5586110d"
