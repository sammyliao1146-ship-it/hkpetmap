        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2tSVFoxcFhORjl3U1ZFd2QyZGtaVFp1YUZOS2VFRRAB&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tSVFoxcFhORjl3U1ZFd2QyZGtaVFp1YUZOS2VFRRAB!2m1!1s0x34040123dad96325:0x552646a5459014a"
