        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tKSVVsWnFOWGxHY0VRNWFuVlZjRU5OVTBOamNHYxAB!2m1!1s0x34040715096f746d:0x4ced62344ef0d36a"
