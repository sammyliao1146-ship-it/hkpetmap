        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT210SVJteHRVVkJ3UVdreWNtVktWMnBFT0ZwNExWRRAB!2m1!1s0x34040861a47d7bad:0x2d659acd7576dba9"
