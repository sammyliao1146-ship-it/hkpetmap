          "photoUri": "https://lh3.googleusercontent.com/a-/ALV-UjW64MhrwUCbGHRravH7eTfKps12itrieileR6XkeerwAGIydZN9=s128-c0x00000000-cc-rp-mo-ba5"
        },
        "publishTime": "2024-12-29T13:46:12.398562Z",
        "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChZDSUhNMG9nS0VJQ0FnSUNmdnBmaERREAE&d=17924085&t=1&wv=1",
        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUNmdnBmaERREAE!2m1!1s0x340401006acfa803:0x5ed444faf6bfb83a"
