        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25CcllWUXRSRmhtVEVoUWNuVnJSR04xVDB3MVZXYxAB!2m1!1s0x3404074a7b2fffff:0x2ce997b2b4c569e6"
