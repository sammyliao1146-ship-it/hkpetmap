        "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21wd2FsODViRkphV2xObE5XZG5RbmRHVmxJNVJHYxAB!2m1!1s0x34040145aada79d3:0x59511b457799e0c0"
